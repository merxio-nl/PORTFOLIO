---
import { useTranslations, localizedPath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="top" class="relative overflow-hidden pt-20 pb-10 md:pt-28 md:pb-12">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <h1 data-reveal class="max-w-2xl text-display font-display text-[var(--color-paper)]">
      {t('hero.heading')}
    </h1>

    <p data-reveal class="mt-4 max-w-xl text-lead text-[var(--color-paper-muted)]">
      {t('hero.subhead')}
    </p>

    <div data-reveal class="mt-7 flex flex-wrap items-center gap-4">
      <a
        href={localizedPath('/#contact', lang)}
        class="rounded-full bg-[var(--color-paper)] px-6 py-3 text-nav text-[var(--color-ink)] transition-opacity duration-200 hover:opacity-90"
      >
        {t('hero.ctaPrimary')}
      </a>
      <a
        href={localizedPath('/#work', lang)}
        class="inline-flex items-center gap-2 text-nav text-[var(--color-paper-muted)] transition-colors duration-200 hover:text-[var(--color-paper)]"
      >
        {t('hero.ctaSecondary')}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
