---
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Hero from '../Hero.astro';
import WorkSection from '../WorkSection.astro';
import Services from '../Services.astro';
import StudioPhilosophy from '../StudioPhilosophy.astro';
import Creator from '../Creator.astro';
import Process from '../Process.astro';
import ContactCta from '../ContactCta.astro';
import Footer from '../Footer.astro';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const meta = {
  en: {
    title: 'JOMO Studio — Web strategy, design & development',
    description:
      'JOMO is a founder-led digital studio building websites for businesses that need to be understood at a glance. Quiet confidence. Strong work. Clear communication.',
  },
  ru: {
    title: 'JOMO Studio — веб-стратегия, дизайн и разработка',
    description:
      'JOMO — студия одного автора, создающая сайты, понятные с первого взгляда. Спокойная уверенность. Сильная работа. Понятная коммуникация.',
  },
} as const;
---

<Base title={meta[lang].title} description={meta[lang].description} lang={lang}>
  <Nav lang={lang} />
  <main>
    <Hero lang={lang} />
    <WorkSection lang={lang} />
    <Services lang={lang} />
    <StudioPhilosophy lang={lang} />
    <Creator lang={lang} />
    <Process lang={lang} />
    <ContactCta lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
