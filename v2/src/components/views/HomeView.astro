---
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Hero from '../Hero.astro';
import WorkSection from '../WorkSection.astro';
import Services from '../Services.astro';
import StudioPhilosophy from '../StudioPhilosophy.astro';
import Creator from '../Creator.astro';
import Process from '../Process.astro';
import ContactCta from '../ContactCta.astro';
import Footer from '../Footer.astro';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const meta = {
  en: {
    title: 'JOMO Studio — Websites from idea to launch',
    description:
      'I design and build websites for businesses, independent professionals, and personal projects, from idea to launch.',
  },
  ru: {
    title: 'JOMO Studio — сайты от идеи до запуска',
    description:
      'Создаю сайты для бизнеса, специалистов и самостоятельных проектов — от идеи до запуска.',
  },
  nl: {
    title: 'JOMO Studio — websites van idee tot lancering',
    description:
      'Ik ontwerp en bouw websites voor bedrijven, zzp\'ers en eigen projecten, van idee tot lancering.',
  },
} as const;
---

<Base title={meta[lang].title} description={meta[lang].description} lang={lang}>
  <Nav lang={lang} />
  <main>
    <Hero lang={lang} />
    <Services lang={lang} />
    <WorkSection lang={lang} />
    <StudioPhilosophy lang={lang} />
    <Creator lang={lang} />
    <Process lang={lang} />
    <ContactCta lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
