---
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import DeviceShowcase from '../DeviceShowcase.astro';
import { useTranslations, localizedPath, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { lang, project, next } = Astro.props;
const t = useTranslations(lang);

const {
  title,
  tagline,
  summary,
  client,
  location,
  liveUrl,
  repoUrl,
  facts,
  problem,
  solution,
  outcome,
  workGallery,
  siteShowcase,
  siteShowcaseMobile,
} = project.data;

const hasNarrative = Boolean(problem || solution);
const nextSlug = next.id.split('/').slice(1).join('/');
---

<Base title={`${title} — JOMO Studio`} description={summary} lang={lang}>
  <Nav lang={lang} />
  <main>
    <!-- Project introduction -->
    <section class="pt-20 pb-6 md:pt-28 md:pb-8">
      <div class="mx-auto max-w-6xl px-6 md:px-10">
        <a
          href={localizedPath('/work/', lang)}
          class="inline-flex items-center gap-2 text-sm text-[var(--color-paper-muted)] transition-colors hover:text-[var(--color-paper)]"
        >
          <span aria-hidden="true">←</span> {t('case.backToWork')}
        </a>

        <p class="mt-6 text-xs tracking-[0.16em] text-[var(--color-brass)] uppercase">
          {t('case.label')}
        </p>
        <h1 class="mt-3 max-w-2xl font-display text-2xl font-semibold text-[var(--color-paper)] sm:text-3xl md:text-4xl">
          {title}
        </h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-[var(--color-paper-muted)] md:text-lg">
          {tagline}
        </p>
      </div>
    </section>

    <!-- Visual product showcase: the delivered website, desktop + mobile -->
    {siteShowcase[0] && (
      <section class="pb-10 md:pb-12">
        <div class="mx-auto max-w-5xl px-6 md:px-10">
          <DeviceShowcase
            desktopSrc={siteShowcase[0].src}
            desktopAlt={siteShowcase[0].alt}
            mobileSrc={siteShowcaseMobile[0]?.src}
            mobileAlt={siteShowcaseMobile[0]?.alt}
            eager
          />
        </div>
      </section>
    )}

    <!-- What was delivered: quick, scannable facts -->
    {facts.length > 0 && (
      <section class="border-t border-[var(--color-hairline)] py-8">
        <div class="mx-auto max-w-6xl px-6 md:px-10">
          <p class="text-xs tracking-[0.12em] text-[var(--color-paper-faint)] uppercase">
            {t('case.delivered')}
          </p>
          <dl class="mt-5 grid grid-cols-2 gap-x-8 gap-y-6 sm:grid-cols-3 md:grid-cols-6">
            {facts.map((fact) => (
              <div>
                <dt class="text-xs text-[var(--color-paper-faint)]">{fact.label}</dt>
                <dd class="mt-1.5 text-sm text-[var(--color-paper)]">{fact.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    {hasNarrative ? (
      <>
        {problem && (
          <section class="border-t border-[var(--color-hairline)] py-8 md:py-10">
            <div class="mx-auto max-w-6xl px-6 md:px-10">
              <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-16">
                <h2 class="font-display text-xl font-semibold text-[var(--color-paper)]">
                  {t('case.problem')}
                </h2>
                <p class="max-w-2xl text-base leading-relaxed text-[var(--color-paper-muted)]">
                  {problem}
                </p>
              </div>
            </div>
          </section>
        )}

        {solution && (
          <section class="border-t border-[var(--color-hairline)] py-8 md:py-10">
            <div class="mx-auto max-w-6xl px-6 md:px-10">
              <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-16">
                <h2 class="font-display text-xl font-semibold text-[var(--color-paper)]">
                  {t('case.solution')}
                </h2>
                <p class="max-w-2xl text-base leading-relaxed text-[var(--color-paper-muted)]">
                  {solution}
                </p>
              </div>
            </div>
          </section>
        )}
      </>
    ) : (
      <section class="border-t border-[var(--color-hairline)] py-8 md:py-10">
        <div class="mx-auto max-w-6xl px-6 md:px-10">
          <div class="grid gap-4 md:grid-cols-[1fr_2fr] md:gap-16">
            <h2 class="font-display text-xl font-semibold text-[var(--color-paper)]">
              {t('case.aboutProject')}
            </h2>
            <div class="max-w-2xl">
              <p class="text-base leading-relaxed text-[var(--color-paper-muted)]">{summary}</p>
              <p class="mt-3 text-sm text-[var(--color-paper-faint)]">
                {t('case.noFullCaseStudy')}
              </p>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Related work: real client-work imagery, secondary to the site showcase -->
    {workGallery.length > 0 && (
      <section class="border-t border-[var(--color-hairline)] py-8 md:py-10">
        <div class="mx-auto max-w-6xl px-6 md:px-10">
          <p class="text-xs tracking-[0.12em] text-[var(--color-paper-faint)] uppercase">
            {t('case.clientWork')}
          </p>
          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {workGallery.map((image) => (
              <div class="overflow-hidden rounded-lg bg-[var(--color-surface)]">
                <img
                  src={image.src}
                  alt={image.alt}
                  class="aspect-[4/3] w-full object-cover"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Outcome: honest, kept small — not a heavy audit-style disclaimer -->
    {outcome && (
      <section class="border-t border-[var(--color-hairline)] py-6">
        <div class="mx-auto max-w-6xl px-6 md:px-10">
          <p class="text-xs tracking-[0.12em] text-[var(--color-paper-faint)] uppercase">
            {t('case.outcome')}
          </p>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-[var(--color-paper-muted)]">
            {outcome}
          </p>
        </div>
      </section>
    )}

    <!-- Live site CTA -->
    <section class="border-t border-[var(--color-hairline)] py-8 md:py-10">
      <div class="mx-auto max-w-6xl px-6 md:px-10">
        <div class="rounded-lg border border-[var(--color-hairline)] bg-[var(--color-surface)] p-6 sm:flex sm:items-center sm:justify-between md:p-8">
          <div>
            <h2 class="font-display text-xl font-semibold text-[var(--color-paper)]">
              {t('case.visitLive')}
            </h2>
            {(client || location) && (
              <p class="mt-1.5 text-sm text-[var(--color-paper-muted)]">
                {[client, location].filter(Boolean).join(' · ')}
              </p>
            )}
          </div>
          <div class="mt-5 flex flex-wrap gap-3 sm:mt-0">
            {liveUrl && (
              <a
                href={liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full bg-[var(--color-paper)] px-5 py-2.5 text-sm font-medium text-[var(--color-ink)] transition-opacity hover:opacity-90"
              >
                {t('case.visitLive')} ↗
              </a>
            )}
            {repoUrl && (
              <a
                href={repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-[var(--color-hairline-strong)] px-5 py-2.5 text-sm text-[var(--color-paper)] transition-colors hover:border-[var(--color-brass)]"
              >
                {t('case.viewRepo')} ↗
              </a>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- Next project navigation -->
    <section class="border-t border-[var(--color-hairline)] py-8">
      <div class="mx-auto max-w-6xl px-6 md:px-10 flex flex-wrap items-center justify-between gap-6">
        <a
          href={localizedPath('/work/', lang)}
          class="text-sm text-[var(--color-paper-muted)] transition-colors hover:text-[var(--color-paper)]"
        >
          {t('case.backToWork')}
        </a>
        <a href={localizedPath(`/work/${nextSlug}/`, lang)} class="group flex items-center gap-4">
          <div class="text-right">
            <p class="text-xs tracking-[0.12em] text-[var(--color-paper-faint)] uppercase">
              {t('case.nextProject')}
            </p>
            <p class="mt-1 font-display text-lg font-semibold text-[var(--color-paper)]">
              {next.data.title}
            </p>
          </div>
          <span
            aria-hidden="true"
            class="font-display text-2xl text-[var(--color-paper-faint)] transition-transform duration-300 group-hover:translate-x-2 group-hover:text-[var(--color-brass)]"
          >
            →
          </span>
        </a>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>
