---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const groups = [
  {
    number: '01',
    name: t('services.strategy.name'),
    summary: t('services.strategy.summary'),
    items: [t('services.strategy.item1'), t('services.strategy.item2'), t('services.strategy.item3')],
  },
  {
    number: '02',
    name: t('services.design.name'),
    summary: t('services.design.summary'),
    items: [t('services.design.item1'), t('services.design.item2'), t('services.design.item3')],
  },
  {
    number: '03',
    name: t('services.development.name'),
    summary: t('services.development.summary'),
    items: [
      t('services.development.item1'),
      t('services.development.item2'),
      t('services.development.item3'),
    ],
  },
];
---

<section id="services" class="border-t border-[var(--color-hairline)] py-12 md:py-16">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <div data-reveal class="max-w-xl">
      <p class="text-eyebrow uppercase text-[var(--color-brass)]">
        {t('services.eyebrow')}
      </p>
      <h2 class="mt-2 text-h2 font-display text-[var(--color-paper)]">
        {t('services.heading')}
      </h2>
      <p class="mt-3 text-lead text-[var(--color-paper-muted)]">
        {t('services.subhead')}
      </p>
    </div>

    <div
      class="mt-8 grid gap-px overflow-hidden rounded-lg border border-[var(--color-hairline)] bg-[var(--color-hairline)] md:grid-cols-3"
    >
      {
        groups.map((group) => (
          <div data-reveal class="bg-[var(--color-ink)] p-6 md:p-7">
            <span class="text-small font-display text-[var(--color-paper-faint)]">
              {group.number}
            </span>
            <h3 class="mt-3 text-h3 font-display text-[var(--color-paper)]">
              {group.name}
            </h3>
            <p class="mt-2.5 text-small text-[var(--color-paper-muted)]">
              {group.summary}
            </p>
            <ul class="mt-4 space-y-1.5 border-t border-[var(--color-hairline)] pt-4">
              {group.items.map((item) => (
                <li class="text-small text-[var(--color-paper-faint)]">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
