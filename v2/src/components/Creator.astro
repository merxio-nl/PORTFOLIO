---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const bio = [t('creator.bio1'), t('creator.bio2'), t('creator.bio3')];
---

<section id="creator" class="border-t border-[var(--color-hairline)] py-10 md:py-12">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <p data-reveal class="text-eyebrow uppercase text-[var(--color-brass)]">
      {t('creator.eyebrow')}
    </p>
    <h2 class="mt-2 text-h2 font-display text-[var(--color-paper)]">
      {t('creator.heading')}
    </h2>

    <!--
      Single-card layout today; built to extend into a small grid of cards
      if JOMO grows into more than one person later.
    -->
    <div
      data-reveal
      class="mt-6 grid gap-6 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-surface)] p-6 sm:grid-cols-[auto_1fr] md:p-7"
    >
      <div
        class="flex h-16 w-16 items-center justify-center rounded-full border border-[var(--color-hairline-strong)] text-h3 font-display text-[var(--color-brass)]"
        aria-hidden="true"
      >
        YR
      </div>

      <div>
        <h3 class="text-h3 font-display text-[var(--color-paper)]">
          {t('creator.name')}
        </h3>
        <p class="mt-0.5 text-small text-[var(--color-paper-muted)]">{t('creator.role')}</p>
        <div class="mt-3 max-w-2xl space-y-3 text-body text-[var(--color-paper-muted)]">
          {bio.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </div>
</section>
