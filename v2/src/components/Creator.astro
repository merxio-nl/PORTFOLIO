---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="creator" class="border-t border-[var(--color-hairline)] py-14 md:py-16">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <p data-reveal class="text-xs tracking-[0.16em] text-[var(--color-brass)] uppercase">
      {t('creator.eyebrow')}
    </p>

    <!--
      Single-card layout today; built to extend into a small grid of cards
      if JOMO grows into more than one person later.
    -->
    <div
      data-reveal
      class="mt-6 grid gap-6 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-surface)] p-6 sm:grid-cols-[auto_1fr] sm:items-center md:p-7"
    >
      <div
        class="flex h-16 w-16 items-center justify-center rounded-full border border-[var(--color-hairline-strong)] font-display text-lg font-semibold text-[var(--color-brass)]"
        aria-hidden="true"
      >
        YR
      </div>

      <div>
        <h3 class="font-display text-lg font-semibold text-[var(--color-paper)]">
          {t('creator.name')}
        </h3>
        <p class="mt-0.5 text-sm text-[var(--color-paper-muted)]">{t('creator.role')}</p>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[var(--color-paper-muted)]">
          {t('creator.bio')}
        </p>
      </div>
    </div>
  </div>
</section>
