---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const paragraphs = [t('studio.p1'), t('studio.p2'), t('studio.p3'), t('studio.p4')];
---

<section id="studio" class="border-t border-[var(--color-hairline)] py-12 md:py-16">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <div data-reveal class="max-w-2xl">
      <p class="text-xs tracking-[0.16em] text-[var(--color-brass)] uppercase">
        {t('studio.eyebrow')}
      </p>
      <h2 class="mt-2 font-display text-2xl font-semibold leading-[1.2] text-[var(--color-paper)] sm:text-3xl">
        {t('studio.heading')}
      </h2>
      <div class="mt-4 space-y-3 text-sm leading-relaxed text-[var(--color-paper-muted)] md:text-base">
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <div
      data-reveal
      class="mt-8 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-surface)] p-6 md:p-8"
    >
      <p class="font-display text-lg font-semibold text-[var(--color-paper)] sm:text-xl">
        {t('studio.closing')}
      </p>
    </div>
  </div>
</section>
