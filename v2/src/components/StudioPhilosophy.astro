---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const paragraphs = [t('studio.p1'), t('studio.p2'), t('studio.p3'), t('studio.p4')];
---

<section id="studio" class="border-t border-[var(--color-hairline)] py-12 md:py-16">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <div data-reveal class="max-w-2xl">
      <p class="text-eyebrow uppercase text-[var(--color-brass)]">
        {t('studio.eyebrow')}
      </p>
      <!--
        The JOMO manifesto line gets the Display treatment (see
        global.css) — the same weight/density reserved for the hero
        statement. It's the one other place on the site that earns it.
      -->
      <h2 class="mt-2 text-display font-display text-[var(--color-paper)]">
        {t('studio.heading')}
      </h2>
      <div class="mt-4 space-y-3 text-body text-[var(--color-paper-muted)]">
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </div>
</section>
