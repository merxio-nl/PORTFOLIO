---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const leaveOut = [
  t('studio.leaveOut1'),
  t('studio.leaveOut2'),
  t('studio.leaveOut3'),
  t('studio.leaveOut4'),
];
const keep = [t('studio.keep1'), t('studio.keep2'), t('studio.keep3'), t('studio.keep4')];
---

<section id="studio" class="border-t border-[var(--color-hairline)] py-16 md:py-20">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <div data-reveal class="max-w-2xl">
      <p class="text-xs tracking-[0.16em] text-[var(--color-brass)] uppercase">
        {t('studio.eyebrow')}
      </p>
      <h2 class="mt-2 font-display text-2xl font-semibold leading-[1.2] text-[var(--color-paper)] sm:text-3xl">
        {t('studio.heading')}
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-[var(--color-paper-muted)] md:text-base">
        {t('studio.body')}
      </p>
    </div>

    <div
      data-reveal
      class="mt-10 grid gap-px overflow-hidden rounded-lg border border-[var(--color-hairline)] bg-[var(--color-hairline)] md:grid-cols-2"
    >
      <div class="bg-[var(--color-ink)] p-6 md:p-7">
        <p class="text-xs tracking-[0.12em] text-[var(--color-paper-faint)] uppercase">
          {t('studio.leaveOutLabel')}
        </p>
        <ul class="mt-4 space-y-3">
          {
            leaveOut.map((item) => (
              <li class="text-sm text-[var(--color-paper-faint)] line-through decoration-[var(--color-hairline-strong)]">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="bg-[var(--color-surface)] p-6 md:p-7">
        <p class="text-xs tracking-[0.12em] text-[var(--color-brass)] uppercase">
          {t('studio.keepLabel')}
        </p>
        <ul class="mt-4 space-y-3">
          {keep.map((item) => <li class="text-sm text-[var(--color-paper)]">{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
