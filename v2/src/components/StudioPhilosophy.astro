---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const focus = [t('studio.focus1'), t('studio.focus2'), t('studio.focus3'), t('studio.focus4')];
---

<section id="studio" class="border-t border-[var(--color-hairline)] py-16 md:py-20">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <div data-reveal class="max-w-2xl">
      <p class="text-xs tracking-[0.16em] text-[var(--color-brass)] uppercase">
        {t('studio.eyebrow')}
      </p>
      <h2 class="mt-2 font-display text-2xl font-semibold leading-[1.2] text-[var(--color-paper)] sm:text-3xl">
        {t('studio.heading')}
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-[var(--color-paper-muted)] md:text-base">
        {t('studio.body')}
      </p>
    </div>

    <div
      data-reveal
      class="mt-10 rounded-lg border border-[var(--color-hairline)] bg-[var(--color-surface)] p-6 md:p-8"
    >
      <p class="text-xs tracking-[0.12em] text-[var(--color-brass)] uppercase">
        {t('studio.focusLabel')}
      </p>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2">
        {
          focus.map((item) => (
            <li class="flex items-start gap-3 text-sm text-[var(--color-paper)]">
              <span
                aria-hidden="true"
                class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-brass)]"
              />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
