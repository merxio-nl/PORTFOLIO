---
import type { CollectionEntry } from 'astro:content';
import DeviceShowcase from './DeviceShowcase.astro';
import { useTranslations, localizedPath, type Lang } from '../i18n/utils';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
  eager?: boolean;
}

const { project, lang, eager = false } = Astro.props;
const { title, category, tagline, siteShowcase, siteShowcaseMobile, coverImage, coverImageAlt } =
  project.data;
const t = useTranslations(lang);
const slug = project.id.split('/').slice(1).join('/');
const href = localizedPath(`/work/${slug}/`, lang);

const desktop = siteShowcase[0];
const mobile = siteShowcaseMobile[0];
---

<a href={href} data-reveal class="group block">
  {
    desktop ? (
      <DeviceShowcase
        desktopSrc={desktop.src}
        desktopAlt={desktop.alt}
        mobileSrc={mobile?.src}
        mobileAlt={mobile?.alt}
        eager={eager}
      />
    ) : (
      <div class="overflow-hidden rounded-lg bg-[var(--color-surface)]">
        <img
          src={coverImage}
          alt={coverImageAlt}
          class="aspect-[16/10] w-full object-cover"
          loading={eager ? 'eager' : 'lazy'}
        />
      </div>
    )
  }

  <div class="mt-5 flex items-start justify-between gap-4">
    <div>
      <p class="text-xs text-[var(--color-paper-faint)]">{category}</p>
      <h3 class="mt-1 font-display text-xl font-semibold text-[var(--color-paper)]">
        {title}
      </h3>
      <p class="mt-1.5 max-w-md text-sm text-[var(--color-paper-muted)]">{tagline}</p>
    </div>
    <span
      aria-hidden="true"
      class="mt-1 shrink-0 text-[var(--color-paper-faint)] transition-transform duration-300 group-hover:translate-x-1 group-hover:text-[var(--color-brass)]"
    >
      →
    </span>
  </div>
  <span class="sr-only">{t('work.viewCaseStudy')}</span>
</a>
