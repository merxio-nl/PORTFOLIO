---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="border-t border-[var(--color-hairline)] py-12 md:py-16">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <div data-reveal class="max-w-xl">
      <p class="text-eyebrow uppercase text-[var(--color-brass)]">
        {t('contact.eyebrow')}
      </p>
      <h2 class="mt-2 text-h2 font-display text-[var(--color-paper)]">
        {t('contact.heading')}
      </h2>
      <p class="mt-3 text-lead text-[var(--color-paper-muted)]">
        {t('contact.body')}
      </p>
    </div>

    <div data-reveal class="mt-6 flex flex-wrap items-center gap-3">
      <a
        href="mailto:redyamusic@outlook.com"
        class="rounded-full bg-[var(--color-paper)] px-6 py-3 text-nav text-[var(--color-ink)] transition-opacity duration-200 hover:opacity-90"
      >
        {t('contact.ctaPrimary')}
      </a>
      <a
        href="https://wa.me/31657337248"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full border border-[var(--color-hairline-strong)] px-6 py-3 text-nav text-[var(--color-paper)] transition-colors duration-200 hover:border-[var(--color-brass)]"
      >
        WhatsApp
      </a>
      <a
        href="https://t.me/merxio_manager"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full border border-[var(--color-hairline-strong)] px-6 py-3 text-nav text-[var(--color-paper)] transition-colors duration-200 hover:border-[var(--color-brass)]"
      >
        Telegram
      </a>
    </div>
  </div>
</section>
